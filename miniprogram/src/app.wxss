page{background:#f7f3ea;color:#292e26;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.65}
.page{padding:40rpx 32rpx 64rpx;padding-bottom:calc(64rpx + env(safe-area-inset-bottom))}.eyebrow{font-size:24rpx;color:#667651}.title{font-size:52rpx;line-height:1.3;font-weight:600;margin:20rpx 0}.muted{color:#77796f}.intro{margin-bottom:32rpx}.search{background:#fffdf8;border:1rpx solid #dcded0;border-radius:16rpx;padding:22rpx 24rpx;height:48rpx}.categories{white-space:nowrap;margin:26rpx 0 32rpx;width:100%}.chip{display:inline-block;padding:12rpx 24rpx;margin-right:14rpx;border-radius:40rpx;background:#ececdf;color:#58614b}.chip.selected{background:#364b32;color:#fffdf8}.recipe-card{background:#fffdf8;border:1rpx solid #e6e4d8;border-radius:20rpx;padding:28rpx 30rpx;margin-bottom:22rpx}.pressed{opacity:.7}.category-name{font-size:23rpx;color:#71805e}.recipe-name{font-size:36rpx;font-weight:600;margin:12rpx 0}.description{color:#77796f;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.card-footer{border-top:1rpx solid #eeeee4;margin-top:22rpx;padding-top:16rpx;color:#526446;font-size:24rpx;display:flex;justify-content:space-between}.footer{text-align:center;font-size:24rpx;padding:30rpx 0}.panel{background:#fffdf8;border-radius:18rpx;padding:28rpx;margin-bottom:22rpx;border:1rpx solid #e6e4d8}.section-title{font-size:36rpx;font-weight:600;margin:44rpx 0 22rpx}.photo-placeholder{background:#e8eadc;color:#68765c;text-align:center;padding:46rpx 24rpx;border-radius:18rpx}.small{font-size:23rpx}.ingredient{padding:20rpx 0;border-bottom:1rpx solid #eeeee4}.ingredient:last-child{border:0}.ingredient-name{font-weight:500}.ingredients{padding-top:8rpx;padding-bottom:8rpx}.servings{margin-bottom:16rpx}.step-heading{color:#526446;font-weight:600;margin-bottom:18rpx;display:flex;justify-content:space-between}.heat{font-weight:400;font-size:24rpx}.step-text{font-size:30rpx;line-height:1.85}.step-note,.tip{margin-top:16rpx;color:#6c7163}.time{margin-top:22rpx;font-size:24rpx;color:#8b663d}.share-button{margin-top:38rpx;background:#364b32;color:#fffdf8;border-radius:16rpx;font-size:28rpx}button::after{border:0}
