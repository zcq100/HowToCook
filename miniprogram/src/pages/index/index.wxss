.library-tools{position:sticky;top:0;z-index:5;background:var(--paper);padding:24rpx 32rpx 0}.search-field{display:flex;align-items:center;gap:24rpx;padding:0 24rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:12rpx;min-height:96rpx}.search-icon{width:26rpx;height:26rpx;border:3rpx solid #84735a;border-radius:50%;position:relative;flex-shrink:0;margin-right:4rpx}.search-icon::after{content:'';position:absolute;right:-10rpx;bottom:-6rpx;width:14rpx;height:3rpx;background:#84735a;transform:rotate(45deg)}.search{flex:1;min-width:0;height:92rpx;font-size:30rpx;color:var(--ink)}.search-placeholder{color:var(--muted)}.search-clear{margin:0 -16rpx 0 0;padding:0;width:80rpx;height:80rpx;line-height:80rpx;background:transparent;color:var(--muted);font-size:40rpx}.library-content{padding:0 32rpx 32rpx}.results-heading{display:flex;align-items:baseline;justify-content:space-between;padding:32rpx 0 16rpx;font-size:26rpx;color:var(--muted)}.results-heading text{font-size:24rpx;font-variant-numeric:tabular-nums}.recipe-list{border-top:3rpx double var(--line)}.recipe-card{display:flex;align-items:center;gap:20rpx;padding:28rpx 0;border-bottom:1rpx solid var(--line)}.recipe-ordinal{font-family:var(--font-ui);font-size:26rpx;color:var(--wine);min-width:32rpx;font-variant-numeric:tabular-nums}.recipe-summary{flex:1;min-width:0}.recipe-name{font-family:var(--font-ui);font-size:36rpx;line-height:1.5;font-weight:600;overflow-wrap:anywhere}.row-arrow{font-size:40rpx;color:var(--gold);padding-top:0}

.difficulty{display:flex;align-items:center;gap:8rpx;flex-shrink:0;color:#76644f;padding:8rpx 0}.difficulty-pip{width:10rpx;height:10rpx;transform:rotate(45deg);border:1rpx solid #c7b48e}.difficulty-pip.filled{background:currentColor;border-color:currentColor}.difficulty-1{color:#56704b}.difficulty-2{color:#71804b}.difficulty-3{color:#916b29}.difficulty-4{color:#a05735}.difficulty-5{color:#7a2e26}

 .categories{display:flex;flex-wrap:wrap;gap:12rpx 16rpx;width:100%;border-bottom:1rpx solid var(--line);padding:24rpx 0}.category{display:flex;align-items:center;justify-content:center;min-height:80rpx;padding:12rpx 24rpx;font-size:28rpx;line-height:1.5;color:var(--muted);border:1rpx solid transparent;border-radius:8rpx;white-space:nowrap}.category.selected{color:var(--wine);background:#efe2c6;border-color:#d3c3a0;font-weight:600}
