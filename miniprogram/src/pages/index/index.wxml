<view class="page">
  <view class="eyebrow">HowToCook · 家常菜谱</view>
  <view class="title">今天，认真吃饭。</view>
  <view class="muted intro">20 道精选样本，先从一顿家常饭开始。</view>
  <input class="search" placeholder="搜菜名或食材，如鸡蛋、豆腐" value="{{query}}" bindinput="onQuery" confirm-type="search" aria-label="搜索菜谱" />
  <scroll-view scroll-x class="categories">
    <view class="chip {{category === '' ? 'selected' : ''}}" data-id="" bindtap="onCategory">全部</view>
    <view wx:for="{{categories}}" wx:key="id" class="chip {{category === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="onCategory">{{item.name}} {{item.count}}</view>
  </scroll-view>
  <view wx:if="{{error}}" class="panel"><text>{{error}}</text><button bindtap="onRetry">重新加载</button></view>
  <view wx:elif="{{!loading && !recipes.length}}" class="panel muted">没有找到，换个菜名或食材试试。</view>
  <view wx:for="{{recipes}}" wx:key="id" class="recipe-card" data-id="{{item.id}}" bindtap="openRecipe" hover-class="pressed">
    <view class="category-name">{{item.categoryName}} · 难度 {{item.difficulty}} / 5</view>
    <view class="recipe-name">{{item.name}}</view>
    <view class="description">{{item.description || '看看需要哪些原料，跟着步骤做一遍。'}}</view>
    <view class="card-footer">查看做法 <text>→</text></view>
  </view>
  <view class="muted footer">{{loading ? '正在找菜谱…' : '验证版 · 菜谱文本已内置，可离线阅读'}}</view>
</view>
