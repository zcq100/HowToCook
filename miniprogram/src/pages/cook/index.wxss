page{background:#e6d9be}.cook-progress{display:flex;gap:6rpx;padding:24rpx 24rpx 0;background:#e6d9be}.cook-segment{flex:1;min-width:0;height:8rpx;border-radius:4rpx;background:#cdbb96}.cook-segment.segment-done{background:#b69b62}.cook-segment.segment-active{background:#7a2e26}.cook-stage{padding:32rpx 24rpx calc(184rpx + env(safe-area-inset-bottom))}.cook-card{position:relative;padding:40rpx 36rpx;background:#fffcf5;border:1rpx solid rgba(167,132,63,.5);box-shadow:0 4rpx 12rpx rgba(70,50,20,.08),0 20rpx 48rpx rgba(70,50,20,.12);color:#3b3127}.cook-card::before{content:'';position:absolute;inset:10rpx;border:1rpx solid rgba(167,132,63,.45);pointer-events:none}.cook-kicker{display:flex;flex-wrap:wrap;gap:16rpx;align-items:center;margin-bottom:28rpx;color:#7a2e26;font-size:28rpx;font-weight:500}.cook-heat{color:#76644f;font-weight:400}.cook-text{font-size:44rpx;line-height:1.85;white-space:pre-wrap;overflow-wrap:anywhere}.cook-note{margin-top:28rpx;padding:16rpx 0 16rpx 24rpx;border-left:4rpx solid #d8c7a3;color:#76644f;font-size:32rpx;line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere}.cook-time{margin-top:32rpx;color:#7a2e26;font-size:28rpx}.cook-uses{margin-top:48rpx;padding-top:24rpx;border-top:1rpx solid #ddd0b4}.cook-uses-title{font-size:26rpx;font-weight:500;color:#76644f;margin-bottom:20rpx}.cook-supplies{display:flex;flex-wrap:wrap;gap:16rpx}.cook-supply{display:flex;flex-wrap:wrap;align-items:baseline;gap:4rpx 12rpx;max-width:100%;padding:12rpx 20rpx;border-radius:8rpx;background:#f1e8d5;font-size:30rpx;line-height:1.65;overflow-wrap:anywhere}.cook-supply-amount{color:#76644f;font-size:26rpx}.cook-amount-note{margin-top:20rpx;font-size:24rpx;color:#76644f;line-height:1.8}.cook-uses .text-button{padding:8rpx 0;text-align:left;width:100%;font-size:28rpx}.cook-nav{position:fixed;left:0;right:0;bottom:0;display:flex;align-items:center;gap:20rpx;background:#fbf6eb;border-top:1rpx solid rgba(167,132,63,.45);padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));z-index:8}.cook-nav>button{margin:0;min-height:104rpx;line-height:1.5;border-radius:12rpx;font-size:32rpx;padding:28rpx 16rpx}.cook-prev{width:112rpx;flex-shrink:0;border:1rpx solid #d3c3a0;background:#fffaf0;color:#2a221a}.cook-next{flex:1;max-width:360rpx;background:#7a2e26;color:#fbf3e2}.cook-position{flex:1;min-width:80rpx;text-align:center}.cook-position-main{font-size:30rpx;font-weight:600;font-variant-numeric:tabular-nums}.cook-position-hint{font-size:22rpx;color:#76644f;margin-top:4rpx}.cook-done{text-align:center}.cook-title{font-size:48rpx;font-weight:600;line-height:1.5;margin-bottom:16rpx;overflow-wrap:anywhere}.cook-sub{font-size:30rpx;color:#76644f;line-height:1.8}.cook-done .cook-kicker{justify-content:center}.cook-done .cook-uses{text-align:left}.cook-done-tip{display:flex;gap:16rpx;font-size:30rpx;line-height:1.8;margin-bottom:16rpx}.cook-done-tip>view{flex:1;min-width:0;white-space:pre-wrap;overflow-wrap:anywhere}.cook-done .secondary-button{width:100%}
@media(max-width:340px){.cook-stage{padding-left:20rpx;padding-right:20rpx}.cook-card{padding-left:28rpx;padding-right:28rpx}.cook-text{font-size:40rpx}.cook-nav{gap:16rpx}.cook-prev{width:96rpx}.cook-nav>button{font-size:30rpx}}

.cook-card .cook-title,
.cook-card .cook-sub,
.cook-card .cook-text,
.cook-card .cook-note,
.cook-card .cook-supply-name,
.cook-card .cook-supply-amount,
.cook-card .cook-done-tip view,
.cook-card .cook-done-tip text { font-family: var(--font-reading); }
