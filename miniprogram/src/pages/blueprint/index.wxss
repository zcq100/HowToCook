page{height:100%;overflow:hidden;background:#18221f;color:#e1e9e2}.blueprint-page{height:100%;display:flex;flex-direction:column;background:#18221f}.blueprint-header{padding:22rpx 28rpx 18rpx;border-bottom:1rpx solid #35413b;flex-shrink:0}.blueprint-name{font-size:32rpx;font-weight:600}.blueprint-hint{font-size:22rpx;color:#9cad9d;margin-top:4rpx}.blueprint-message{padding:48rpx 28rpx;color:#b6c4b7}.graph-viewport{position:relative;flex:1;min-height:0;overflow:hidden;background-color:#18221f;background-image:radial-gradient(#35413b 1px,transparent 1px);background-size:20px 20px;touch-action:none}.connection-canvas{position:absolute;left:0;top:0;width:100%;height:100%;z-index:0;pointer-events:none}.graph-layer{position:absolute;left:0;top:0;transform-origin:0 0;z-index:1;pointer-events:none}.graph-node{position:absolute;box-sizing:border-box;pointer-events:auto;background:#26352e;border:1px solid #61745f;border-radius:10px;padding:15px 16px;font-size:14px;line-height:1.65;color:#e1e9e2;overflow:visible}.node-heading{font-size:15px;font-weight:600;margin-bottom:8px;color:#e0e8df}.node-body{overflow-wrap:anywhere;white-space:pre-wrap}.node-step{background:#22363e;border-color:#507684}.node-step .node-heading{color:#b8dae7}.node-start{background:#432d2c;border-color:#91615b}.node-result{background:#35432b;border-color:#7b915d}.node-ingredient{background:#303a28;border-color:#718151}.node-kind{float:right;font-size:10px;font-weight:400;color:#c1ceaa}.node-note{font-size:12px;margin-top:10px;color:#b1c0b4;white-space:pre-wrap}.node-meta{font-size:11px;color:#d4bd8b;margin-top:10px}.node-muted{opacity:.55}.node-active{border-color:#e4d29b;box-shadow:0 0 0 2px #e4d29b}.node-unlinked{border-style:dashed}.data-pin{position:absolute;top:27px;width:8px;height:8px;background:#b9cb78;border-radius:50%;border:1px solid #e1ebc3}.output-pin{right:-5px}.input-pin{left:-5px}.flow-pin{position:absolute;width:8px;height:8px;left:calc(50% - 4px);background:#dce6df;transform:rotate(45deg)}.top-pin{top:-5px}.bottom-pin{bottom:-5px}.graph-controls{flex-shrink:0;border-top:1rpx solid #35413b;background:#202c25;padding:12rpx 20rpx calc(16rpx + env(safe-area-inset-bottom))}.zoom-controls,.step-controls{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.zoom-controls{margin-bottom:12rpx}.graph-controls button{margin:0;padding:0 18rpx;line-height:64rpx;font-size:24rpx;color:#e0e8df;background:#354638;border-radius:10rpx;min-width:64rpx}.graph-controls button[disabled]{opacity:.35;color:#c4cfc1}.zoom-controls text{font-size:22rpx;color:#aab9a8}.step-controls text{font-size:23rpx;color:#d3dfce}.step-controls button{flex-shrink:0}
