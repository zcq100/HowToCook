page{background:#e6d9be}.recipe-stage{padding:24rpx 20rpx calc(32rpx + env(safe-area-inset-bottom))}.menu-sheet{position:relative;max-width:100%;background:#fffcf5;border:1rpx solid rgba(167,132,63,.5);padding:56rpx 36rpx 24rpx;box-shadow:0 4rpx 12rpx rgba(70,50,20,.08),0 20rpx 48rpx rgba(70,50,20,.12);color:#3b3127}.menu-sheet::before{content:'';position:absolute;inset:10rpx;border:1rpx solid rgba(167,132,63,.45);pointer-events:none}.menu-header{text-align:center}.menu-title{font-family:var(--font-ui);font-size:48rpx;font-weight:600;line-height:1.55;letter-spacing:4rpx;color:#1f1812;overflow-wrap:anywhere}.menu-ornament{display:flex;align-items:center;justify-content:center;gap:16rpx;margin:20rpx auto;color:#a7843f}.menu-ornament view{height:1rpx;width:48rpx;background:#c6ae7d}.menu-ornament text{font-size:24rpx;line-height:1}.menu-meta{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:12rpx 24rpx;font-size:24rpx;color:#76644f}.menu-difficulty{display:flex;gap:2rpx}.menu-star{color:#b8a37a;font-size:24rpx}.menu-star.star-on{color:#85642a}.menu-description{text-align:justify;color:#4b3f31;font-size:30rpx;line-height:1.95;margin-top:32rpx;white-space:pre-wrap;overflow-wrap:anywhere}.menu-section{margin-top:48rpx}.menu-section-heading{display:flex;align-items:center;justify-content:center;gap:24rpx;color:#7a2e26;margin-bottom:24rpx}.menu-section-heading>text{font-size:36rpx;font-weight:600;letter-spacing:6rpx;flex-shrink:0}.menu-rule{height:6rpx;border-top:1rpx solid rgba(167,132,63,.5);border-bottom:1rpx solid rgba(167,132,63,.5);flex:1;max-width:180rpx}.menu-servings{text-align:center;font-size:26rpx;color:#76644f;margin:-8rpx 0 24rpx;line-height:1.8;overflow-wrap:anywhere}.menu-ingredient{display:flex;align-items:baseline;gap:12rpx;padding:10rpx 0;font-size:30rpx;line-height:1.8}.menu-ingredient-name{flex:0 1 auto;max-width:52%;min-width:0;color:#2a221a;overflow-wrap:anywhere}.menu-leader{flex:1;min-width:16rpx;border-bottom:1rpx dotted #b8a37a;transform:translateY(-6rpx)}.menu-amount{flex:0 1 auto;max-width:52%;min-width:0;text-align:right;color:#5e5140;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.menu-tools{font-size:26rpx;line-height:1.9;color:#76644f;margin-top:24rpx;overflow-wrap:anywhere}.menu-step{display:flex;align-items:baseline;gap:16rpx;margin-bottom:28rpx}.menu-step:last-child{margin-bottom:0}.menu-step-number{flex-shrink:0;min-width:28rpx;text-align:right;color:#a7843f;font-size:30rpx;font-variant-numeric:tabular-nums}.menu-step-content{flex:1;min-width:0}.menu-step-text{font-size:32rpx;line-height:1.95;white-space:pre-wrap;overflow-wrap:anywhere}.menu-note{font-size:28rpx;line-height:1.85;margin-top:16rpx;padding:8rpx 0 8rpx 20rpx;border-left:3rpx solid #d8c7a3;color:#76644f;white-space:pre-wrap;overflow-wrap:anywhere}.menu-tip{display:flex;gap:16rpx;font-size:30rpx;line-height:1.9;margin-bottom:16rpx;overflow-wrap:anywhere}.menu-tip>view{flex:1;min-width:0;white-space:pre-wrap}.menu-bullet{flex-shrink:0;color:#a7843f}.menu-actions{padding:0 12rpx}.menu-actions .text-button{width:100%;margin-top:8rpx}.menu-gallery{margin-top:32rpx;display:flex;flex-direction:column;gap:24rpx}.menu-photo{display:block;width:100%;padding:8rpx;background:#fffdf8;border:1rpx solid rgba(167,132,63,.45)}
@media(max-width:340px){.menu-sheet{padding-left:28rpx;padding-right:28rpx}.menu-title{font-size:44rpx;letter-spacing:2rpx}.menu-section-heading{gap:16rpx}}

/* Override the global UI font on reading elements, including native text nodes. */
.menu-sheet .menu-title,
.menu-sheet .menu-section-heading text,
.menu-sheet .menu-description,
.menu-sheet .menu-servings,
.menu-sheet .menu-ingredient-name,
.menu-sheet .menu-amount,
.menu-sheet .menu-tools,
.menu-sheet .menu-step-number,
.menu-sheet .menu-step-text,
.menu-sheet .menu-note,
.menu-sheet .menu-tip view,
.menu-sheet .menu-tip text { font-family: var(--font-reading); }
