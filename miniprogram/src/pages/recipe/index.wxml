<include src="../../templates/recipe-tabs.wxml" />
<view class="recipe-stage">
  <view wx:if="{{loading}}" class="empty-state">正在准备菜谱…</view>
  <view wx:elif="{{error}}" class="empty-state"><view class="empty-title">暂时无法打开菜谱</view><view>{{error}}</view><button class="secondary-button" bindtap="onRetry">重新加载</button><button class="text-button" bindtap="goHome">查看其他菜谱</button></view>
  <block wx:elif="{{recipe}}">
    <view class="menu-sheet">
      <view class="menu-header">
        <view class="menu-title">{{recipe.name}}</view>
        <view class="menu-ornament" aria-hidden="true"><view></view><text>◇</text><view></view></view>
        <view class="menu-meta"><view class="menu-difficulty" aria-label="难度 {{recipe.difficulty}} 级，共 5 级"><text wx:for="{{difficultyLevels}}" wx:for-item="level" wx:key="*this" class="menu-star {{level <= recipe.difficulty ? 'star-on' : ''}}">{{level <= recipe.difficulty ? '★' : '☆'}}</text></view><text wx:if="{{recipe.calories}}">{{recipe.calories}}</text><text>{{recipe.categoryName}}</text></view>
        <view wx:if="{{recipe.images.length}}" class="menu-gallery"><image wx:for="{{recipe.images}}" wx:key="*this" src="{{item}}" mode="widthFix" lazy-load class="menu-photo" /></view>
        <view wx:if="{{recipe.description}}" class="menu-description" selectable>{{recipe.description}}</view>
      </view>
      <view class="menu-section">
        <view class="menu-section-heading"><view class="menu-rule"></view><text>原料</text><view class="menu-rule"></view></view>
        <view wx:if="{{recipe.servingsNote}}" class="menu-servings">{{recipe.servingsNote}}</view>
        <view class="menu-ingredients"><view wx:for="{{recipe.foodIngredients}}" wx:key="id" class="menu-ingredient"><view class="menu-ingredient-name">{{item.name}}</view><view class="menu-leader"></view><view class="menu-amount">{{item.amountsText}}</view></view></view>
        <view wx:if="{{recipe.toolsText}}" class="menu-tools">工具：{{recipe.toolsText}}</view>
      </view>
      <view class="menu-section">
        <view class="menu-section-heading"><view class="menu-rule"></view><text>操作</text><view class="menu-rule"></view></view>
        <view class="menu-steps"><view wx:for="{{recipe.steps}}" wx:key="id" class="menu-step"><text class="menu-step-number">{{index + 1}}.</text><view class="menu-step-content"><view class="menu-step-text" selectable>{{item.text}}</view><view wx:for="{{item.notes}}" wx:for-item="note" wx:key="*this" class="menu-note" selectable>{{note}}</view></view></view></view>
      </view>
      <view wx:if="{{recipe.tips.length}}" class="menu-section">
        <view class="menu-section-heading"><view class="menu-rule"></view><text>附加内容</text><view class="menu-rule"></view></view>
        <view wx:for="{{recipe.tips}}" wx:key="*this" class="menu-tip"><text class="menu-bullet">·</text><view selectable>{{item}}</view></view>
      </view>
    </view>
    <view class="menu-actions"><button class="primary-button" data-view="cook" bindtap="switchView">开始跟做 →</button><button class="text-button" open-type="share">分享这道菜</button></view>
  </block>
</view>
